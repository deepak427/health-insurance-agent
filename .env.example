# Copy this to .env and fill in your values

# ── Gemini API ─────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_USE_ENTERPRISE=0

# ── Sessions (SQLite default — works great on single EC2 instance) ─────────────
# Leave as-is for SQLite. For multi-instance swap to postgres:
# SESSION_SERVICE_URI=postgresql+asyncpg://user:password@host:5432/dbname
SESSION_SERVICE_URI=sqlite+aiosqlite:///./sessions.db

# ── Artifacts ──────────────────────────────────────────────────────────────────
# Leave unset to use local filesystem on EC2 (persists across restarts)
# For S3: ARTIFACT_SERVICE_URI=s3://your-bucket-name  +  AWS_REGION=us-east-1
# ARTIFACT_SERVICE_URI=
# AWS_REGION=us-east-1

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000

# ── WhatsApp Integration (Meta Cloud API) ──────────────────────────────────────
# Get these from your Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_TOKEN=your_permanent_system_user_token_here
# Any secret string you set in Meta App Dashboard → Webhooks → Verify Token
WHATSAPP_VERIFY_TOKEN=dolphin_verify
# Public URL of this server (used for sending PDF artifacts as document links)
# Must be reachable by Meta's servers. Example: https://api.yourdomain.com
PUBLIC_BASE_URL=https://your-ec2-domain-or-ip:8000
